# TaxMate AI Environment Configuration

# Application
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM Providers (Gemini / OpenAI / Mock)
# Default is 'gemini' if GEMINI_API_KEY is present, or fallback to 'mock' for 100% offline self-contained demo
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_MODEL=gemini-2.5-flash

# RAG & Embeddings
EMBEDDING_PROVIDER=mock
VECTOR_STORE_PATH=data/vector_store
RAG_TOP_K=4
HYBRID_SEARCH_ENABLED=true
RERANKING_ENABLED=true

# Security & Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx,txt
RATE_LIMIT_PER_MINUTE=60
MASK_PII_LOGS=true
REQUIRE_HUMAN_CONFIRMATION_ON_WRITE=true
